{
  "name": "synthetic-voters-toy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome lint --error-on-warnings .",
    "size": "node --experimental-strip-types scripts/size-check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-svelte": "^0.562.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.15.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.6",
    "vitest": "^3.2.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "@biomejs/biome"] }
}
